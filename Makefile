# Универсальный Makefile для сборки заданий c_extend
# Автоматически находит все .c файлы в подпапках и собирает из каждого
# исполняемый файл с тем же именем (hw1_a0.c -> hw1_a0)

CC      = gcc
CFLAGS  = -Wall -Wextra -std=c99

# Все исходники .c в этой директории и поддиректориях
SRCS := $(shell find . -name '*.c')
# Для каждого исходника исполняемый файл (убираем расширение .c)
BINS := $(SRCS:.c=)

# Правило по умолчанию: собрать все задания
all: $(BINS)

# Общее правило: исполняемый файл из исходника с тем же именем.
# $< — зависимость (исходник), $@ — цель (исполняемый файл)
%: %.c
	$(CC) $(CFLAGS) -o $@ $<

# Очистка от всех собранных исполняемых файлов
clean:
	rm -f $(BINS)

.PHONY: all clean
